# Windows-side overrides on top of navigation2's own nav2_params.yaml.
#
# Every server in bridge\windows\nav2_stack.bat is started the same way -
# `--params-file <nav2_params.yaml> --params-file <this file>` - and
# `lifecycle_manager` reads only this one, because upstream's params file has no
# block for it at all.
#
# Parameters are applied in the order the arguments appear, so a block here wins
# over the same parameter in the upstream file. Only what actually differs is
# listed - everything else comes from nav2_params.yaml untouched, which is the
# point of loading it at all.

# Every message on the bridge is stamped with the robot's simulation clock -
# `/odom` says 397 s while the wall clock is at 1.79e9 s - so a node that pairs
# its own `now()` with a stamped message is 56 years away from the message it is
# pairing with. `use_sim_time` is what closes that: the shim's `now()` then
# follows `/clock`, which the daemon mirrors from the robot (see
# `bridge/docs/03-validation.md`, evidence 19).
planner_server:
  ros__parameters:
    use_sim_time: true

amcl:
  ros__parameters:
    use_sim_time: true

# The behavior server reads the `local_costmap_raw` / `global_costmap_raw` topics
# its collision checkers run on, and those are stamped with the simulation clock
# like everything else the bridge carries. Upstream's block in nav2_params.yaml
# already names the topics and the plugins; the clock and the command-velocity
# type are overridden.
behavior_server:
  ros__parameters:
    use_sim_time: true
    # Same reason as `controller_server` above, reached through a different
    # publisher: nav2_util::TwistPublisher stamps /cmd_vel by default, the robot
    # subscribes to plain Twist, and the bridge forwards a topic by name under
    # whatever type the writer used. Left true, the recovery branch publishes
    # TwistStamped and the robot reads the header as `linear.x` - the spin turns
    # nothing, and the behavior times out with "Exceeded time allowance before
    # reaching the Spin goal" while /cmd_vel looks busy.
    enable_stamped_cmd_vel: false

controller_server:
  ros__parameters:
    use_sim_time: true
    # nav2 1.5 publishes geometry_msgs/msg/TwistStamped on /cmd_vel by default
    # (`enable_stamped_cmd_vel` defaults to true in nav2_util::TwistPublisher).
    # The bridge forwards /cmd_vel by its *name*, so what travels to the robot
    # is whatever this node writes into the shared-memory channel under the type
    # the peer advertised - and the reference robot subscribes to plain Twist.
    # Two types on one topic name is exactly what plain ROS2 would refuse to
    # match, so the port pins the type instead of reinterpreting bytes: a
    # TwistStamped payload read as a Twist starts with the header, so its
    # `linear.x` decodes to a denormal near zero and the robot simply never
    # moves - with no error anywhere.
    enable_stamped_cmd_vel: false
    # Upstream's file selects nav2_mppi_controller::MPPIController, which is not
    # part of this port. nav2_regulated_pure_pursuit_controller is, and it is
    # what the demo drives.
    FollowPath:
      plugin: "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"
      desired_linear_vel: 0.45
      lookahead_dist: 0.55
      min_lookahead_dist: 0.3
      max_lookahead_dist: 0.9
      use_velocity_scaled_lookahead_dist: false
      min_approach_linear_velocity: 0.05
      approach_velocity_scaling_dist: 0.6
      use_collision_detection: true
      max_allowed_time_to_collision_up_to_carrot: 1.0
      use_regulated_linear_velocity_scaling: true
      use_cost_regulated_linear_velocity_scaling: false
      regulated_linear_scaling_min_radius: 0.9
      regulated_linear_scaling_min_speed: 0.25
      use_rotate_to_heading: true
      rotate_to_heading_min_angle: 0.785
      max_angular_accel: 2.0
      rotate_to_heading_angular_vel: 0.8
      transform_tolerance: 1.0
# Both of these are lifecycle servers with no timers of their own until a goal
# arrives, but waypoint_follower's `NavigateToPose` client and the poses it
# compares are stamped, so the clock has to match the rest of the graph.
smoother_server:
  ros__parameters:
    use_sim_time: true

waypoint_follower:
  ros__parameters:
    use_sim_time: true

# Upstream's file is written to be rewritten by a launch file, which also
# substitutes two placeholders on the way: `KEEPOUT_ZONE_ENABLED` and
# `SPEED_ZONE_ENABLED` are words in the file and `True` or `False` by the time a
# node sees them. Read as they stand they would be strings, and the costmap
# filters that read them as booleans would abort the costmap they belong to. Both
# are `use_keepout_zones` / `use_speed_zones` in navigation_launch.py; the port
# has no keepout or speed mask server to feed those filters, so both are off
# here, the way nav2's own system tests run them. The blocks repeat the nesting
# the upstream file uses, which is what the loader matches.
local_costmap:
  local_costmap:
    ros__parameters:
      keepout_filter:
        enabled: false
global_costmap:
  global_costmap:
    ros__parameters:
      keepout_filter:
        enabled: false
      speed_filter:
        enabled: false

# The BT action server hands these two to every behavior tree node it loads
# (see nav2_behavior_tree/bt_action_server_impl.hpp). Upstream's 20 ms / 50 ms
# assume a robot computer where a service round trip is microseconds; on this
# port a round trip is a shared-memory publish plus the node's own work, and the
# 42 ms measured for the first `follow_path` request already exceeds 20 ms.
# What that looks like when it trips is a WARN in the navigator log and a
# recovery branch that runs for no reason, so the budget is a second here.
bt_navigator:
  ros__parameters:
    use_sim_time: true
    default_server_timeout: 1000
    default_cancel_timeout: 1000
    # Upstream's default tree ends in a recovery round robin of Spin / Wait /
    # BackUp, served by nav2_behaviors' behavior server - `behavior_server.exe`
    # below. Those three leaves are back in the trees this port ships (the file
    # headers say what else is and is not in them). They only work while the
    # behavior server is up, and because a behavior tree is built when the
    # navigator activates, a missing action server keeps the whole navigator
    # from activating; that is why the manager's `node_names` lists the behavior
    # server too.
    default_nav_to_pose_bt_xml: "$(env NAV2_SHIM_BT_DIR)/navigate_to_pose.xml"
    default_nav_through_poses_bt_xml: "$(env NAV2_SHIM_BT_DIR)/navigate_through_poses.xml"

# nav2_bringup passes these from its launch file, so upstream's params file has
# no lifecycle_manager block at all. `node_names` is a string array, and a
# command line `-p` cannot spell one - hence a file.
#
# This is the whole reference stack: planner, controller, the BT navigator that
# drives them, the behavior server its recovery branch sends to, the path
# smoother and the waypoint navigator. bt_navigator needs the behavior trees to
# be findable (see `bt_search_directories` and apps/bt_navigator_node.cpp) and
# nothing else, so bringing all six up from one manager is what
# `bridge\windows\nav2_stack.bat` does. Drop a name here to bring a subset up on
# its own - but a subset without `behavior_server` leaves the recovery leaves of
# both trees without an action server, and bt_navigator then will not activate.
lifecycle_manager:
  ros__parameters:
    autostart: true
    node_names:
      ["controller_server", "planner_server", "bt_navigator", "behavior_server",
       "smoother_server", "waypoint_follower"]
    # The shim's bond is a no-op (nothing can crash without bringing the whole
    # machine's shared memory down with it), so the crash-respawn machinery is
    # pointless here; 0.0 turns the bond timer off instead of letting it tick.
    bond_timeout: 0.0
    attempt_respawn_reconnection: false
