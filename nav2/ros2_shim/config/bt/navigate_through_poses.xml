<!--
  The tree `bt_navigator`'s navigate_through_poses navigator loads instead of
  upstream's `navigate_through_poses_w_replanning_and_recovery.xml`.

  Same shape as `navigate_to_pose.xml` next to this file, recovery round robin
  included: `Spin`, `Wait` and `BackUp` are served by `behavior_server.exe`,
  which `nav2_stack.bat` starts. A tree is built when the navigator activates,
  so an absent behavior server keeps the *whole* navigator from activating, not
  just its recovery branch - which is why both trees carry the three leaves or
  neither does.

  The `path_handler_selector` / `ValidatePath` machinery upstream's current
  file uses is not registered here; everything else is upstream's.

  `RemovePassedGoals` is not optional. `NavigateThroughPoses` reads
  `number_of_poses_remaining` and `distance_remaining` straight off the
  blackboard `{goals}` array, and that node is the only thing that ever shrinks
  it - the navigator seeds `{waypoint_statuses}` once, in `initializeGoalPoses`,
  and `nav2_controller` never touches it. A tree without the node therefore
  plans through all of the goals forever, re-reaching waypoint 0 every pass and
  never advancing: the car orbits the first pose with `number_of_recoveries`
  climbing until `NavigateRecovery` gives up. The `waypoint_statuses` ports are
  what mark each consumed pose COMPLETED for the action result.

  `FollowPath` below takes neither `goal_checker_id` nor `progress_checker_id`,
  matching `navigate_to_pose.xml` next to this file. Both selectors default to
  upstream's plugin name `general_goal_checker`, which `racecar`'s `nav.yaml` does
  not define (`goal_checker_plugins: ["goal_checker"]`). A BT port is a literal
  string, so - unlike upstream's Python launch files, which rewrite the XML before
  handing it to the navigator - it cannot be re-pointed from the params file.
  Passing a name that is not in `goal_checker_plugins` makes `nav2_controller`
  reject the entire goal ("FollowPath called with goal_checker name ... which does
  not exist"); leaving the ports unset makes it fall back to the single loaded
  plugin (`controller_server.cpp` `findGoalCheckerId` / `findProgressCheckerId`),
  which is what the working `navigate_to_pose` path already does.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigateThroughPosesWReplanning">
  <BehaviorTree ID="NavigateThroughPosesWReplanning">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ProgressCheckerSelector selected_progress_checker="{selected_progress_checker}" default_progress_checker="progress_checker" topic_name="progress_checker_selector"/>
        <GoalCheckerSelector selected_goal_checker="{selected_goal_checker}" default_goal_checker="general_goal_checker" topic_name="goal_checker_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.333">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ReactiveSequence name="RemovePassedGoalsThenPlan">
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7" input_waypoint_statuses="{waypoint_statuses}" output_waypoint_statuses="{waypoint_statuses}"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}" tracking_feedback="{tracking_feedback}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <RoundRobin name="RecoveryActions">
        <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        <Spin spin_dist="1.57" error_code_id="{spin_error_code}" error_msg="{spin_error_msg}"/>
        <Wait wait_duration="5.0" error_code_id="{wait_error_code}" error_msg="{wait_error_msg}"/>
        <BackUp backup_dist="0.30" backup_speed="0.15" error_code_id="{backup_error_code}" error_msg="{backup_error_msg}"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
